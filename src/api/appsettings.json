{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorldAlerts": {
    "News": {
      "PollingEnabled": true,
      "PollMinutes": 15,
      "RequestTimeoutSeconds": 20,
      "Feeds": [
        {
          "Id": "bbc-world",
          "Name": "BBC World",
          "Url": "https://feeds.bbci.co.uk/news/world/rss.xml",
          "Family": "world-news"
        },
        {
          "Id": "nyt-world",
          "Name": "NYT World",
          "Url": "https://rss.nytimes.com/services/xml/rss/nyt/World.xml",
          "Family": "world-news"
        },
        {
          "Id": "aljazeera-all",
          "Name": "Al Jazeera English",
          "Url": "https://www.aljazeera.com/xml/rss/all.xml",
          "Family": "world-news"
        },
        {
          "Id": "guardian-world",
          "Name": "The Guardian World",
          "Url": "https://www.theguardian.com/world/rss",
          "Family": "world-news"
        },
        {
          "Id": "ars-technica",
          "Name": "Ars Technica",
          "Url": "https://feeds.arstechnica.com/arstechnica/index",
          "Family": "consequential-tech"
        },
        {
          "Id": "nature",
          "Name": "Nature",
          "Url": "https://www.nature.com/nature.rss",
          "Family": "transformative-science"
        }
      ]
    },
    "Markets": {
      "PollingEnabled": true,
      "PollMinutes": 10,
      "RequestTimeoutSeconds": 20,
      "Sources": [
        {
          "Id": "binance-btcusdt-ticker",
          "Name": "Binance BTC/USDT 24h ticker",
          "Kind": "binance-ticker",
          "Url": "https://api.binance.com/api/v3/ticker/24hr?symbol=BTCUSDT",
          "Venue": "Binance",
          "Region": "Global",
          "Instrument": "BTCUSDT",
          "QuoteUnit": "USDT",
          "Symbol": "BTCUSDT",
          "Interval": "24h",
          "Delayed": false,
          "DelaySemantics": "Real-time 24-hour rolling ticker; observation time is the ticker close time."
        },
        {
          "Id": "binance-btcusdt-1h",
          "Name": "Binance BTC/USDT hourly candles",
          "Kind": "binance-klines",
          "Url": "https://api.binance.com/api/v3/klines?symbol=BTCUSDT&interval=1h&limit=25",
          "Venue": "Binance",
          "Region": "Global",
          "Instrument": "BTCUSDT",
          "QuoteUnit": "USDT",
          "Symbol": "BTCUSDT",
          "Interval": "1h",
          "Delayed": false,
          "DelaySemantics": "Hourly Binance spot candles; observation time is the candle open time."
        },
        {
          "Id": "frankfurter-eurusd",
          "Name": "Frankfurter ECB EUR/USD",
          "Kind": "frankfurter",
          "Url": "https://api.frankfurter.app/latest?from=EUR&to=USD",
          "Venue": "European Central Bank reference (Frankfurter)",
          "Region": "Euro area / United States",
          "Instrument": "EUR/USD",
          "QuoteUnit": "USD per EUR",
          "FromCurrency": "EUR",
          "ToCurrency": "USD",
          "Interval": "1d",
          "Delayed": true,
          "DelaySemantics": "ECB daily reference rate; observation time is the reference date, never an intraday quote."
        },
        {
          "Id": "cboe-spx-delayed",
          "Name": "Cboe delayed SPX quote",
          "Kind": "cboe",
          "Url": "https://cdn-api.cboe.com/api/global/delayed_quotes/quotes/_SPX.json",
          "Venue": "Cboe",
          "Region": "United States",
          "Instrument": "SPX",
          "QuoteUnit": "index points",
          "Interval": "quote",
          "Delayed": true,
          "DelaySemantics": "Delayed Cboe quote; observation time is the provider's last-trade timestamp."
        },
        {
          "Id": "twse-eod",
          "Name": "Taiwan Stock Exchange end-of-day closes",
          "Kind": "twse",
          "Url": "https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_AVG_ALL",
          "Venue": "Taiwan Stock Exchange",
          "Region": "Taiwan",
          "Instrument": "TWSE listed securities",
          "QuoteUnit": "TWD",
          "Interval": "1d",
          "Instruments": [
            "0050"
          ],
          "Delayed": true,
          "DelaySemantics": "Taiwan end-of-day closing prices; observation time is the ROC trading date when supplied, otherwise the fetch date in Taipei, stored as a date marker."
        },
        {
          "Id": "moex-imoex",
          "Name": "MOEX IMOEX index snapshot",
          "Kind": "moex",
          "Url": "https://iss.moex.com/iss/engines/stock/markets/index/boards/SNDX/securities/IMOEX.json?iss.meta=off",
          "Venue": "Moscow Exchange",
          "Region": "Russia",
          "Instrument": "IMOEX",
          "QuoteUnit": "index points",
          "Interval": "quote",
          "Delayed": true,
          "DelaySemantics": "MOEX ISS public snapshot; may be delayed by exchange policy. Observation time is the exchange snapshot time."
        }
      ]
    },
    "Disasters": {
      "PollingEnabled": true,
      "PollMinutes": 10,
      "RequestTimeoutSeconds": 20,
      "Sources": [
        {
          "Id": "gdacs",
          "Name": "GDACS RSS",
          "Kind": "gdacs-rss",
          "Url": "https://www.gdacs.org/xml/rss.xml"
        },
        {
          "Id": "eonet",
          "Name": "NASA EONET",
          "Kind": "eonet",
          "Url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=open&limit=50",
          "Categories": [
            "volcanoes",
            "landslides",
            "drought"
          ]
        },
        {
          "Id": "usgs",
          "Name": "USGS all-day earthquakes",
          "Kind": "usgs",
          "Url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson"
        },
        {
          "Id": "ifrc-go",
          "Name": "IFRC GO events",
          "Kind": "ifrc",
          "Url": "https://goadmin.ifrc.org/api/v2/event/"
        },
        {
          "Id": "dwd-warnings",
          "Name": "DWD official heat and cold warnings",
          "Kind": "dwd-warnings",
          "Url": "https://www.dwd.de/DWD/warnungen/warnapp/json/warnings.json",
          "Events": [
            "HITZE",
            "EXTREME HITZE",
            "FROST",
            "STRENGE FROST"
          ],
          "Semantics": "Germany only; DWD heat/frost warnings. A 2026-10-21 live payload contained only B\u00d6EN/WINDB\u00d6EN, so the heat/frost event names follow DWD's documented labels."
        },
        {
          "Id": "nws-alerts",
          "Name": "NWS active alerts",
          "Kind": "nws",
          "Url": "https://api.weather.gov/alerts/active",
          "Events": [
            "Tsunami Warning",
            "Heat Advisory",
            "Excessive Heat Warning",
            "Extreme Cold Warning"
          ],
          "Semantics": "US/territories only; NWS alerts are authoritative for the United States."
        },
        {
          "Id": "copernicus-ems",
          "Name": "Copernicus EMS activations",
          "Kind": "copernicus-ems",
          "Url": "https://rapidmapping.emergency.copernicus.eu/backend/dashboard-api/public-activations-info/",
          "PageSize": 100,
          "MaxPages": 3,
          "MaxItems": 300
        },
        {
          "Id": "emsc",
          "Name": "EMSC earthquakes",
          "Kind": "emsc",
          "Url": "https://www.seismicportal.eu/fdsnws/event/1/query?format=json&limit=50",
          "Semantics": "CC BY 4.0; seismicportal.eu"
        }
      ]
    }
  }
}
