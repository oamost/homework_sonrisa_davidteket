{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorldAlerts": {
    "News": {
      "PollingEnabled": true,
      "PollMinutes": 15,
      "RequestTimeoutSeconds": 20,
      "Feeds": [
        {
          "Id": "bbc-world",
          "Name": "BBC World",
          "Url": "https://feeds.bbci.co.uk/news/world/rss.xml",
          "Family": "world-news"
        },
        {
          "Id": "nyt-world",
          "Name": "NYT World",
          "Url": "https://rss.nytimes.com/services/xml/rss/nyt/World.xml",
          "Family": "world-news"
        },
        {
          "Id": "aljazeera-all",
          "Name": "Al Jazeera English",
          "Url": "https://www.aljazeera.com/xml/rss/all.xml",
          "Family": "world-news"
        },
        {
          "Id": "guardian-world",
          "Name": "The Guardian World",
          "Url": "https://www.theguardian.com/world/rss",
          "Family": "world-news"
        },
        {
          "Id": "ars-technica",
          "Name": "Ars Technica",
          "Url": "https://feeds.arstechnica.com/arstechnica/index",
          "Family": "consequential-tech"
        },
        {
          "Id": "nature",
          "Name": "Nature",
          "Url": "https://www.nature.com/nature.rss",
          "Family": "transformative-science"
        }
      ]
    },
    "Disasters": {
      "PollingEnabled": true,
      "PollMinutes": 10,
      "RequestTimeoutSeconds": 20,
      "Sources": [
        {
          "Id": "gdacs",
          "Name": "GDACS RSS",
          "Kind": "gdacs-rss",
          "Url": "https://www.gdacs.org/xml/rss.xml"
        },
        {
          "Id": "eonet",
          "Name": "NASA EONET",
          "Kind": "eonet",
          "Url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=open&limit=50",
          "Categories": [
            "volcanoes",
            "landslides",
            "drought"
          ]
        },
        {
          "Id": "usgs",
          "Name": "USGS all-day earthquakes",
          "Kind": "usgs",
          "Url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson"
        },
        {
          "Id": "ifrc-go",
          "Name": "IFRC GO events",
          "Kind": "ifrc",
          "Url": "https://goadmin.ifrc.org/api/v2/event/"
        },
        {
          "Id": "dwd-warnings",
          "Name": "DWD official heat and cold warnings",
          "Kind": "dwd-warnings",
          "Url": "https://www.dwd.de/DWD/warnungen/warnapp/json/warnings.json",
          "Events": [
            "HITZE",
            "EXTREME HITZE",
            "FROST",
            "STRENGE FROST"
          ],
          "Semantics": "Germany only; DWD heat/frost warnings. A 2026-10-21 live payload contained only B\u00d6EN/WINDB\u00d6EN, so the heat/frost event names follow DWD's documented labels."
        },
        {
          "Id": "nws-alerts",
          "Name": "NWS active alerts",
          "Kind": "nws",
          "Url": "https://api.weather.gov/alerts/active",
          "Events": [
            "Tsunami Warning",
            "Heat Advisory",
            "Excessive Heat Warning",
            "Extreme Cold Warning"
          ],
          "Semantics": "US/territories only; NWS alerts are authoritative for the United States."
        },
        {
          "Id": "copernicus-ems",
          "Name": "Copernicus EMS activations",
          "Kind": "copernicus-ems",
          "Url": "https://rapidmapping.emergency.copernicus.eu/backend/dashboard-api/public-activations-info/",
          "PageSize": 100,
          "MaxPages": 3,
          "MaxItems": 300
        },
        {
          "Id": "emsc",
          "Name": "EMSC earthquakes",
          "Kind": "emsc",
          "Url": "https://www.seismicportal.eu/fdsnws/event/1/query?format=json&limit=50",
          "Semantics": "CC BY 4.0; seismicportal.eu"
        }
      ]
    }
  }
}
